{
  "name": "zephyria",
  "version": "0.1.0",
  "description": "O Mundo de Zephyria — game 3D cooperativo multiplataforma (Three.js)",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "webpack serve --config tools/build/webpack.config.cjs --mode development",
    "build": "webpack --config tools/build/webpack.config.cjs --mode production",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint . --ext .ts,.tsx",
    "format": "prettier --write .",
    "preview": "webpack serve --config tools/build/webpack.config.cjs --mode production",
    "prepare": "husky"
  },
  "dependencies": {
    "@dimforge/rapier3d-compat": "^0.21.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "three": "^0.186.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "^0.186.0",
    "@typescript-eslint/eslint-plugin": "^8.72.0",
    "@typescript-eslint/parser": "^8.72.0",
    "@vitest/coverage-v8": "^5.0.5",
    "copy-webpack-plugin": "^12.0.2",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "html-webpack-plugin": "^5.6.8",
    "husky": "^9.1.7",
    "jsdom": "^30.1.3",
    "lint-staged": "^17.6.0",
    "prettier": "^3.9.10",
    "ts-loader": "^9.6.2",
    "typescript": "^5.6.0",
    "vite": "^8.3.5",
    "vitest": "^5.0.5",
    "webpack": "^5.112.2",
    "webpack-cli": "^5.1.4",
    "webpack-dev-server": "^5.1.0"
  }
}
